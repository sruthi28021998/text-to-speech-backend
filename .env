PORT=5000
NODE_ENV=development

CLIENT_ORIGIN=http://localhost:5173

# TTS provider (free, keyless Google Translate TTS via the "gtts" package)
# If you later swap in Azure/Polly/ElevenLabs, add their keys here instead:
# TTS_API_KEY=your_api_key
# TTS_REGION=your_region
# TTS_ENDPOINT=your_endpoint

MAX_TEXT_LENGTH=2000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10